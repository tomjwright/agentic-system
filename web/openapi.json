  "components": {
    "schemas": {
      "AccessCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "not_checked",
              "no_prohibited_road_found"
            ],
            "title": "Status",
            "description": "Access anywhere else on the route is unknown, never verified"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source",
            "description": "The OpenStreetMap extract the check used"
          },
          "roads": {
            "items": {
              "$ref": "#/components/schemas/RestrictedRoad"
            },
            "type": "array",
            "title": "Roads"
          }
        },
        "type": "object",
        "required": [
          "status",
          "source",
          "roads"
        ],
        "title": "AccessCheck"
      },
      "Candidate": {
        "properties": {
          "source": {
            "type": "string",
            "const": "onemap",
            "title": "Source",
            "default": "onemap"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "postal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "name",
          "address",
          "postal",
          "point"
        ],
        "title": "Candidate"
      },
      "ConfirmedStart": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "onemap",
              "map_selection"
            ],
            "title": "Source"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "postal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "source",
          "source_id",
          "query",
          "name",
          "address",
          "postal",
          "point",
          "retrieved_at"
        ],
        "title": "ConfirmedStart"
      },
      "DistanceBoundsOut": {
        "properties": {
          "min_m": {
            "type": "number",
            "title": "Min M"
          },
          "max_m": {
            "type": "number",
            "title": "Max M"
          }
        },
        "type": "object",
        "required": [
          "min_m",
          "max_m"
        ],
        "title": "DistanceBoundsOut"
      },
      "DistanceRange": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "range",
            "title": "Kind"
          },
          "min_km": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Min Km"
          },
          "max_km": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "min_km",
          "max_km"
        ],
        "title": "DistanceRange",
        "description": "Exact lower and upper bounds. No tolerance is added on either side."
      },
      "DistanceTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "target",
            "title": "Kind"
          },
          "target_km": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Target Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "target_km"
        ],
        "title": "DistanceTarget",
        "description": "One distance to aim for. A loop within 10% either side of it is acceptable."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "outside_singapore",
              "candidate_not_found",
              "not_found",
              "provider_not_configured",
              "provider_unavailable",
              "provider_rejected",
              "provider_response_invalid",
              "provider_quota_exhausted",
              "operation_conflict",
              "no_route_selected",
              "generation_interrupted"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "GenerationRun": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "route_request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Route Request Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "description": "The request revision, numbered from 1; never changed"
          },
          "distance": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DistanceTarget"
              },
              {
                "$ref": "#/components/schemas/DistanceRange"
              }
            ],
            "title": "Distance",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "range": "#/components/schemas/DistanceRange",
                "target": "#/components/schemas/DistanceTarget"
              }
            }
          },
          "bounds": {
            "$ref": "#/components/schemas/DistanceBoundsOut",
            "description": "Accepted distance in metres"
          },
          "status": {
            "type": "string",
            "enum": [
              "generating",
              "succeeded",
              "no_route",
              "failed"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/RouteCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "provider": {
            "type": "string",
            "const": "heigit",
            "title": "Provider",
            "default": "heigit"
          },
          "profile": {
            "type": "string",
            "title": "Profile"
          },
          "generator_version": {
            "type": "string",
            "title": "Generator Version"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "route_request_id",
          "revision",
          "distance",
          "bounds",
          "status",
          "error",
          "candidates",
          "profile",
          "generator_version",
          "started_at",
          "finished_at"
        ],
        "title": "GenerationRun"
      },
      "LineString": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Coordinates",
            "description": "[longitude, latitude] in degrees"
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "LineString"
      },
      "MapStartChoice": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "map",
            "title": "Kind"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "point"
        ],
        "title": "MapStartChoice"
      },
      "NamedStartChoice": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "named",
            "title": "Kind"
          },
          "query": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Query"
          },
          "source_id": {
            "type": "string",
            "maxLength": 300,
            "title": "Source Id"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "query",
          "source_id"
        ],
        "title": "NamedStartChoice"
      },
      "PlaceSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "PlaceSearchRequest"
      },
      "PlaceSearchResponse": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "no_match",
              "single_match",
              "multiple_matches"
            ],
            "title": "Outcome",
            "description": "A start is never chosen automatically: even a single match needs confirming."
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "more_results": {
            "type": "boolean",
            "title": "More Results",
            "description": "OneMap has more pages; a more specific query helps."
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "candidates",
          "more_results"
        ],
        "title": "PlaceSearchResponse"
      },
      "Point": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Point",
            "title": "Type",
            "default": "Point"
          },
          "coordinates": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordinates",
            "description": "[longitude, latitude] in degrees"
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "Point"
      },
      "RestrictedRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "expressway",
              "expressway slip road",
              "road tunnel",
              "bicycle=no",
              "major arterial (trunk)"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "osm_way_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Osm Way Ids"
          },
          "near_m": {
            "type": "number",
            "title": "Near M",
            "description": "Route length within 8 m: crossings, bridges, paths beside"
          },
          "on_m": {
            "type": "number",
            "title": "On M",
            "description": "Route length running along the road itself"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "on_prohibited_road",
              "crossing_or_beside",
              "on_disclosed_road"
            ],
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "name",
          "osm_way_ids",
          "near_m",
          "on_m",
          "outcome"
        ],
        "title": "RestrictedRoad",
        "description": "One OpenStreetMap road from the restriction check that the route comes near."
      },
      "RouteCandidate": {
        "properties": {
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "method": {
            "type": "string",
            "enum": [
              "round_trip",
              "via_loop"
            ],
            "title": "Method"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Round-trip seed; null for a via loop"
          },
          "requested_length_m": {
            "type": "integer",
            "title": "Requested Length M",
            "description": "Length asked of HeiGIT, after correction"
          },
          "measured_distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured Distance M",
            "description": "Measured along the returned geometry"
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "description": "Why this candidate was rejected; empty if accepted"
          }
        },
        "type": "object",
        "required": [
          "position",
          "method",
          "seed",
          "requested_length_m",
          "measured_distance_m",
          "accepted",
          "reasons"
        ],
        "title": "RouteCandidate"
      },
      "RouteRequest": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "activity": {
            "type": "string",
            "enum": [
              "running",
              "road_cycling"
            ],
            "title": "Activity"
          },
          "start": {
            "$ref": "#/components/schemas/ConfirmedStart"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "activity",
          "start",
          "created_at"
        ],
        "title": "RouteRequest"
      },
      "RouteRequestCreate": {
        "properties": {
          "activity": {
            "type": "string",
            "enum": [
              "running",
              "road_cycling"
            ],
            "title": "Activity"
          },
          "start": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NamedStartChoice"
              },
              {
                "$ref": "#/components/schemas/MapStartChoice"
              }
            ],
            "title": "Start",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "map": "#/components/schemas/MapStartChoice",
                "named": "#/components/schemas/NamedStartChoice"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "activity",
          "start"
        ],
        "title": "RouteRequestCreate"
      },
      "RunCreate": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id",
            "description": "Chosen by the client. Sending the same one again returns the same run."
          },
          "distance": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DistanceTarget"
              },
              {
                "$ref": "#/components/schemas/DistanceRange"
              }
            ],
            "title": "Distance",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "range": "#/components/schemas/DistanceRange",
                "target": "#/components/schemas/DistanceTarget"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "operation_id",
          "distance"
        ],
        "title": "RunCreate"
      },
      "SelectedRoute": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "geometry": {
            "$ref": "#/components/schemas/LineString"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M",
            "description": "Measured along the geometry"
          },
          "target_m": {
            "type": "number",
            "title": "Target M"
          },
          "deviation_m": {
            "type": "number",
            "title": "Deviation M",
            "description": "distance_m minus target_m"
          },
          "bounds": {
            "$ref": "#/components/schemas/DistanceBoundsOut"
          },
          "activity": {
            "type": "string",
            "enum": [
              "running",
              "road_cycling"
            ],
            "title": "Activity"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "description": "HeiGIT profile: foot-walking or cycling-road"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S",
            "description": "HeiGIT's time for the profile. For running it is a walking time."
          },
          "surfaces": {
            "items": {
              "$ref": "#/components/schemas/SurfaceDistance"
            },
            "type": "array",
            "title": "Surfaces"
          },
          "unknown_surface_share": {
            "type": "number",
            "title": "Unknown Surface Share",
            "description": "Share of the distance with no known surface"
          },
          "access": {
            "$ref": "#/components/schemas/AccessCheck"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          },
          "provider_engine": {
            "type": "string",
            "title": "Provider Engine"
          },
          "selected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Selected At"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "geometry",
          "distance_m",
          "target_m",
          "deviation_m",
          "bounds",
          "activity",
          "profile",
          "duration_s",
          "surfaces",
          "unknown_surface_share",
          "access",
          "limitations",
          "attribution",
          "provider_engine",
          "selected_at"
        ],
        "title": "SelectedRoute"
      },
      "SurfaceDistance": {
        "properties": {
          "surface": {
            "type": "string",
            "title": "Surface"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M"
          }
        },
        "type": "object",
        "required": [
          "surface",
          "distance_m"
        ],
        "title": "SurfaceDistance"
      }
    }
  }
}
