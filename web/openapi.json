        }
      }
    },
    "/api/route-requests/{route_request_id}/runs": {
      "post": {
        "summary": "Start Run",
        "description": "Generate a loop now and return the finished run.\n\nRetrying with the same operation_id returns the run already recorded (HTTP 200),\neven while it is still generating; a different distance is refused.",
        "operationId": "start_run_api_route_requests__route_request_id__runs_post",
        "parameters": [
          {
            "name": "route_request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Route Request Id"
            }
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,64}$"
